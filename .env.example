# Copy to .env, then generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-your-generated-random-secret
# SQLite is the default for local practice. Docker Compose overrides this with MySQL.
# DATABASE_URL=mysql+pymysql://student:your-password@127.0.0.1:3306/student_performance
ACCESS_TOKEN_MINUTES=30
MYSQL_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-root-password
